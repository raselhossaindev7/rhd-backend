# ─── Database ──────────────────────────────────────────────
# Runtime: Supabase pooler, TRANSACTION mode (port 6543).
# Format: postgresql://postgres.<ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=10
# Note: URL-encode special chars in password ($ -> %24, & -> %26, @ -> %40)
# Pool sizing: read paths use SEQUENTIAL awaits (max 1 checkout at a time,
# released between queries) — never $transaction batches or Promise.all.
# The admin fires ~10 concurrent requests on load, so connection_limit
# below 10 starves the pool (was 5 = outages).
# pool_timeout=10 + connect_timeout=10: fail fast (503) instead of hanging;
# hangs piled up into a retry storm that took down every endpoint (P1001).
DATABASE_URL="postgresql://postgres.ref:encoded-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=10"
# Migrations/DDL only (`prisma migrate deploy`). SESSION-mode pooler (5432)
# supports DDL; transaction mode (6543) does not reliably. Same password.
# NOTE: the direct hostname db.<ref>.supabase.co may not resolve on all
# networks — the session-mode pooler host below always works.
DIRECT_URL="postgresql://postgres.ref:encoded-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=10"

# ─── JWT ───────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://admin.raselhossain.dev"

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ─── Cloudflare R2 ─────────────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_BUCKET_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ─── Nodemailer (Gmail SMTP) ──────────────────────────────
# Generate App Password: Google Account → Security → 2FA → App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Your Name <your-email@gmail.com>"

# ─── AI Provider (fallback defaults — primary config lives in Settings UI) ──
# provider: ollama | gemini | openrouter | groq
# AI_PROVIDER="ollama"
# AI_MODEL=""
# AI_BASE_URL=""
# OLLAMA_API_KEY=""
# GEMINI_API_KEY=""       # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=""   # https://openrouter.ai/keys
# GROQ_API_KEY=""         # https://console.groq.com/keys
# CEREBRAS_API_KEY=""     # https://cloud.cerebras.ai/

# ─── Blog Images (optional — works without keys) ───────────
# Best relevance: free key from https://www.pexels.com/api/
# Without it: Openverse (CC search) → Pollinations (AI topical) → Picsum
# PEXELS_API_KEY=""
