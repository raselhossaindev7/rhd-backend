{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/index.ts"
    },
    {
      "source": "/health",
      "destination": "api/index.ts"
    },
    {
      "source": "/((?!api/|health|_next|favicon.ico|.*\\..*).*)",
      "destination": "api/index.ts"
    }
  ]
}
